---
import Layout from "@/layouts/main.astro"

const seo = {
  title: "All Topics | Financial Handbook",
  description: "Browse 22 practical guides on budgeting, debt, investing, taxes, insurance, and the money decisions that show up in real life.",
}

const essentialTopics = [
  {
    title: "Budgeting & Saving",
      description: "Get clear on your cash flow, cut the guesswork, and build a budget you can live with.",
    href: "/topics/budgeting-and-saving",
  },
  {
    title: "Emergency Funds",
      description: "How much cash to keep, where to keep it, and how to rebuild after life lands a punch.",
    href: "/topics/emergency-funds",
  },
  {
    title: "Debt Management",
      description: "How to pay debt down in a sane order, avoid the usual traps, and stop interest from running your life.",
    href: "/topics/debt-management",
  },
  {
    title: "Banking Basics",
      description: "Checking, savings, CDs, and high-yield accounts—what each one does and where your cash should sit.",
    href: "/topics/banking-basics",
  },
]

const incomeTopics = [
  {
    title: "Income Optimization",
      description: "Salary negotiation, benefits, job changes, and building income that doesn't depend on one lever.",
    href: "/topics/income-optimization",
  },
  {
    title: "Spending Psychology",
      description: "Why you spend the way you do, and how to make that pattern less expensive.",
    href: "/topics/spending-psychology",
  },
]

const buildingWealthTopics = [
  {
    title: "Credit Scores",
      description: "What moves your score, how to build credit, and which credit myths cost people real money.",
    href: "/topics/credit-scores",
  },
  {
    title: "Investing 101",
      description: "Stocks, bonds, index funds, and retirement accounts without the finance-bro fog.",
    href: "/topics/investing-101",
  },
  {
    title: "Retirement Planning",
      description: "401(k)s, IRAs, withdrawal strategy, and the math behind eventually not working anymore.",
    href: "/topics/retirement-planning",
  },
  {
    title: "Advanced Investing",
      description: "Asset allocation, rebalancing, and tax moves for people who already have the basics down.",
    href: "/topics/advanced-investing",
  },
  {
    title: "Side Income & Entrepreneurship",
      description: "Taxes, business structure, and money systems for freelance work and small businesses.",
    href: "/topics/side-income",
  },
]

const lifeTopics = [
  {
    title: "Housing Decisions",
      description: "Renting, buying, mortgages, and the real cost of putting a roof over your head.",
    href: "/topics/housing-decisions",
  },
  {
    title: "Relationships & Money",
      description: "How couples handle accounts, conflict, red flags, prenups, and splitting up when needed.",
    href: "/topics/relationships-and-money",
  },
  {
    title: "Having Kids",
      description: "What changes financially when kids enter the picture, from childcare to insurance to college savings.",
    href: "/topics/having-kids",
  },
  {
    title: "Major Purchases",
      description: "A calmer way to think through cars, appliances, furniture, and other expensive decisions.",
    href: "/topics/major-purchases",
  },
]

const protectionTopics = [
  {
    title: "Insurance",
      description: "What insurance is for, which policies matter, and how to stop paying for coverage you don't need.",
    href: "/topics/insurance",
  },
  {
    title: "Taxes Simplified",
      description: "Tax brackets, deductions, credits, and filing basics without the usual headache.",
    href: "/topics/taxes-simplified",
  },
  {
    title: "Estate Planning",
      description: "Wills, beneficiaries, powers of attorney, and the paperwork your family will wish you handled.",
    href: "/topics/estate-planning",
  },
  {
    title: "Fraud & Identity Theft",
      description: "How scams work, how to spot them faster, and what to do if someone gets through.",
    href: "/topics/fraud-and-identity-theft",
  },
  {
    title: "Job Loss Survival",
      description: "What to do in the first few days after losing income, and how to steady the situation fast.",
    href: "/topics/job-loss-survival",
  },
]

const mindsetTopics = [
  {
    title: "Money & Mental Health",
      description: "Financial anxiety, money shame, compulsive spending, and where practical help meets actual mental health support.",
    href: "/topics/money-and-mental-health",
  },
  {
    title: "Values-Based Spending",
      description: "Spend more on what actually matters to you and less on the stuff that quietly doesn't.",
    href: "/topics/values-based-spending",
  },
]
---

<Layout currentPath="/topics" seo={seo}>
  <div class="py-12 px-8">
    <!-- Header -->
    <div class="mb-12">
      <a 
        href="/" 
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6"
      >
        <svg 
          class="h-4 w-4 rotate-180" 
          fill="none" 
          viewBox="0 0 24 24" 
          stroke="currentColor" 
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
        </svg>
        <span>Back to home</span>
      </a>
      <h1 class="font-heading text-3xl font-semibold tracking-tight">
        All Topics
      </h1>
      <p class="mt-2 text-muted-foreground">
        22 guides on the money basics, life changes, and long-term decisions most people eventually run into.
      </p>
    </div>

    <!-- Essential -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">The Essentials</span>
        <div class="h-px flex-1 bg-border/50"></div>
        <span class="text-xs text-muted-foreground">Start here if you're new</span>
      </div>
      <div class="grid gap-2">
        {essentialTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Income & Spending -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Income & Spending</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {incomeTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Building Wealth -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Building Wealth</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {buildingWealthTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Major Life Events -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Major Life Events</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {lifeTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Protection & Planning -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Protection & Planning</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {protectionTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Mindset & Psychology -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Mindset & Psychology</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {mindsetTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <div class="pt-8 border-t border-border/50">
      <p class="text-sm text-muted-foreground">
        <span class="text-foreground font-medium">Can't find what you need?</span> 
        Start with <a href="/topics/budgeting-and-saving" class="underline underline-offset-2 hover:text-foreground transition-colors">Budgeting & Saving</a> or 
        <a href="/" class="underline underline-offset-2 hover:text-foreground transition-colors">go back home</a>.
      </p>
    </div>
  </div>
</Layout>
