---
import Layout from "@/layouts/main.astro"

const seo = {
  title: "All Topics | Financial Handbook",
  description: "Browse 22 comprehensive guides covering everything from budgeting basics to advanced investing, taxes, insurance, and life events.",
}

const essentialTopics = [
  {
    title: "Budgeting & Saving",
    description: "The foundation of every financial decision. Learn how to track income, control spending, and build a system that actually sticks.",
    href: "/topics/budgeting-and-saving",
  },
  {
    title: "Emergency Funds",
    description: "Life happens. A solid emergency fund is your financial shock absorber—here's how much you need, where to keep it, and how to build it fast.",
    href: "/topics/emergency-funds",
  },
  {
    title: "Debt Management",
    description: "Strategies to tackle debt systematically. From avalanche to snowball methods, learn how to eliminate debt and avoid common traps.",
    href: "/topics/debt-management",
  },
  {
    title: "Banking Basics",
    description: "Checking, savings, CDs, high-yield accounts. Understand the tools banks offer and how to use them to your advantage.",
    href: "/topics/banking-basics",
  },
]

const incomeTopics = [
  {
    title: "Income Optimization",
    description: "Negotiating salary, understanding benefits, job hopping strategy, and building multiple income streams.",
    href: "/topics/income-optimization",
  },
  {
    title: "Spending Psychology",
    description: "Behavioral economics, impulse control, lifestyle inflation, and understanding your money scripts.",
    href: "/topics/spending-psychology",
  },
]

const buildingWealthTopics = [
  {
    title: "Credit Scores",
    description: "Understand what affects your score, how to build credit from scratch, and myths that can actually hurt your financial standing.",
    href: "/topics/credit-scores",
  },
  {
    title: "Investing 101",
    description: "Stocks, bonds, index funds, 401(k)s, IRAs. Learn how to make your money work for you without needing a finance degree.",
    href: "/topics/investing-101",
  },
  {
    title: "Retirement Planning",
    description: "401(k) vs IRA deep dives, withdrawal strategies, social security, and figuring out when you can actually retire.",
    href: "/topics/retirement-planning",
  },
  {
    title: "Advanced Investing",
    description: "Asset allocation, rebalancing, tax-loss harvesting, and alternative investments for those ready to go deeper.",
    href: "/topics/advanced-investing",
  },
  {
    title: "Side Income & Entrepreneurship",
    description: "Freelancing taxes, business structures, and keeping your personal and business finances separate.",
    href: "/topics/side-income",
  },
]

const lifeTopics = [
  {
    title: "Housing Decisions",
    description: "Rent vs buy, mortgages, closing costs, and the hidden costs of homeownership nobody talks about.",
    href: "/topics/housing-decisions",
  },
  {
    title: "Relationships & Money",
    description: "Couples finance, joint vs separate accounts, financial red flags, prenups, and divorce financial planning.",
    href: "/topics/relationships-and-money",
  },
  {
    title: "Having Kids",
    description: "Childcare costs, 529 plans, tax credits, and adjusting your financial plan for growing families.",
    href: "/topics/having-kids",
  },
  {
    title: "Major Purchases",
    description: "Cars, electronics, appliances—how to think about big spending decisions without regret.",
    href: "/topics/major-purchases",
  },
]

const protectionTopics = [
  {
    title: "Insurance",
    description: "Health, auto, life, renters—know what coverage you actually need, how to compare policies, and when you're overpaying.",
    href: "/topics/insurance",
  },
  {
    title: "Taxes Simplified",
    description: "Demystify tax brackets, deductions, credits, and filing. Know what you owe, what you can save, and how to stay organized.",
    href: "/topics/taxes-simplified",
  },
  {
    title: "Estate Planning",
    description: "Wills, trusts, beneficiary designations, and power of attorney—not just for rich people.",
    href: "/topics/estate-planning",
  },
  {
    title: "Fraud & Identity Theft",
    description: "Common scams, credit monitoring, recovery steps, and keeping your financial identity secure.",
    href: "/topics/fraud-and-identity-theft",
  },
  {
    title: "Job Loss Survival",
    description: "Severance, unemployment benefits, COBRA, and rapid financial triage when income disappears.",
    href: "/topics/job-loss-survival",
  },
]

const mindsetTopics = [
  {
    title: "Money & Mental Health",
    description: "Financial anxiety, money shame, compulsive spending, and resources for financial therapy.",
    href: "/topics/money-and-mental-health",
  },
  {
    title: "Values-Based Spending",
    description: "Aligning your money with your priorities, the fulfillment budget, and designing a life you actually want.",
    href: "/topics/values-based-spending",
  },
]
---

<Layout currentPath="/topics" seo={seo}>
  <div class="py-12 px-8">
    <!-- Header -->
    <div class="mb-12">
      <a 
        href="/" 
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6"
      >
        <svg 
          class="h-4 w-4 rotate-180" 
          fill="none" 
          viewBox="0 0 24 24" 
          stroke="currentColor" 
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
        </svg>
        <span>Back to home</span>
      </a>
      <h1 class="font-heading text-3xl font-semibold tracking-tight">
        All Topics
      </h1>
      <p class="mt-2 text-muted-foreground">
        22 guides covering everything from budgeting basics to advanced investing and life events.
      </p>
    </div>

    <!-- Essential -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">The Essentials</span>
        <div class="h-px flex-1 bg-border/50"></div>
        <span class="text-xs text-muted-foreground">Start here if you're new</span>
      </div>
      <div class="grid gap-2">
        {essentialTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Income & Spending -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Income & Spending</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {incomeTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Building Wealth -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Building Wealth</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {buildingWealthTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Major Life Events -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Major Life Events</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {lifeTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Protection & Planning -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Protection & Planning</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {protectionTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1 leading-relaxed">
                {topic.description}
              </p>
            </div>
            <svg 
              class="h-5 w-5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2"
