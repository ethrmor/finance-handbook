    <!-- Mindset & Psychology -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-heading text-foreground font-medium uppercase tracking-widest">Mindset & Psychology</span>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
      <div class="grid gap-2">
        {mindsetTopics.map((topic) => (
          <a
            href={topic.href}
            class="group flex items-start gap-4 p-4 rounded-lg border border-border/40 bg-background hover:border-primary/30 hover:bg-muted/30 transition-all"
